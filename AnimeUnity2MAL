#!/usr/bin/env python3
"""
AnimeUnity to MyAnimeList/AniList Exporter - Refactored Edition
Converte una lista HTML salvata dal profilo AnimeUnity in un file XML 
strutturato in modo nativo e pronto per l'importazione.
"""

import argparse
import json
import re
import time
import logging
from typing import List, Dict, Optional, Any
import xml.etree.ElementTree as ET
from xml.dom import minidom

import requests
from requests.exceptions import RequestException
from bs4 import BeautifulSoup

# --- Configurazione Ambientale ---
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [*] %(message)s',
    datefmt='%H:%M:%S'
)
logger = logging.getLogger(__name__)

ANILIST_API_URL = 'https://graphql.anilist.co'

# Compilazione delle regex a livello di modulo per prestazioni ottimali
CLEANUP_PATTERNS = [
    re.compile(r'\(ITA\)', re.IGNORECASE),
    re.compile(r'Le Bizzarre Avventure di ', re.IGNORECASE),
    re.compile(r' - L\'ospite indesiderato', re.IGNORECASE),
    re.compile(r' - La leggenda di Aang', re.IGNORECASE),
    re.compile(r'\(.*?\)|\[.*?\]')  # Rimuove tutto tra tonde e quadre in un colpo solo
]

def clean_title_for_api(title: str) -> str:
    """
    Pulisce il titolo in modo incrementale usando le regex pre-compilate.
    """
    c_title = title
    for pattern in CLEANUP_PATTERNS:
        c_title = pattern.sub('', c_title)
    return c_title.strip()

def parse_animeunity_html(html_file: str) -> List[Dict[str, Any]]:
    """Estrae i dati degli anime effettuando il parsing del DOM."""
    logger.info(f"Parsing dell'HTML: {html_file}...")
    try:
        with open(html_file, 'r', encoding='utf-8') as f:
            soup = BeautifulSoup(f, 'html.parser')
    except IOError as e:
        logger.error(f"Impossibile leggere il file HTML: {e}")
        return []

    anime_list: List[Dict[str, Any]] = []
    
    for sec in soup.find_all('div', class_='list-section'):
        status_tag = sec.find('h3', class_='list-title')
        if not status_tag: 
            continue
            
        status = status_tag.text.strip()
        status = 'Plan to Watch' if status.lower() == 'plan to watch' else status
            
        for entry in sec.find_all('div', class_='entry-card'):
            title_tag = entry.find('div', class_='title')
            title = title_tag.text.strip() if title_tag else "Sconosciuto"
            
            progress_tag = entry.find('div', class_='progress')
            watched = "0"
            if progress_tag:
                p_text = progress_tag.text.strip()
                watched = p_text.split('/')[0] if '/' in p_text else p_text
            
            score_tag = entry.find('div', class_='score')
            score = "0"
            if score_tag and score_tag.find('div'):
                score = score_tag.find('div').text.strip() or "0"
                    
            anime_list.append({
                'title': title,
                'watched': watched,
                'score': score,
                'status': status
            })
            
    return anime_list

def get_mal_id(clean_title: str) -> Optional[int]:
    """Interroga le API GraphQL di AniList con gestione robusta degli errori e rate limit."""
    query = '''
    query ($search: String) {
      Media (search: $search, type: ANIME) {
        idMal
      }
    }
    '''
    variables = {'search': clean_title}
    
    while True:
        try:
            response = requests.post(
                ANILIST_API_URL, 
                json={'query': query, 'variables': variables},
                timeout=10
            )
            
            if response.status_code == 200:
                data = response.json()
                media = data.get('data', {}).get('Media')
                return media.get('idMal') if media else None
                
            elif response.status_code == 429:
                retry_after = int(response.headers.get('Retry-After', 60))
                logger.warning(f"Rate limit raggiunto. Pausa tattica di {retry_after}s...")
                time.sleep(retry_after)
                continue
                
            else:
                logger.debug(f"Risposta API inattesa: HTTP {response.status_code}")
                return None
                
        except RequestException as e:
            logger.error(f"Errore di rete durante la ricerca di '{clean_title}': {e}")
            return None

def generate_robust_xml(anime_list: List[Dict[str, Any]], output_file: str) -> None:
    """Genera l'XML utilizzando il modulo nativo ElementTree per garantire l'escaping."""
    root = ET.Element("myanimelist")
    
    myinfo = ET.SubElement(root, "myinfo")
    ET.SubElement(myinfo, "user_id").text = "12345"
    ET.SubElement(myinfo, "user_name").text = "ImportUser"
    ET.SubElement(myinfo, "user_export_type").text = "1"
    ET.SubElement(myinfo, "user_total_anime").text = str(len(anime_list))

    for anime in anime_list:
        anime_node = ET.SubElement(root, "anime")
        ET.SubElement(anime_node, "series_animedb_id").text = str(anime.get("mal_id", 0))
        # ElementTree gestisce in automatico l'escaping dei caratteri speciali (es. <, >, &)
        ET.SubElement(anime_node, "series_title").text = anime["title"]
        ET.SubElement(anime_node, "series_type").text = "TV"
        ET.SubElement(anime_node, "series_episodes").text = "0"
        ET.SubElement(anime_node, "my_id").text = "0"
        ET.SubElement(anime_node, "my_watched_episodes").text = str(anime["watched"])
        ET.SubElement(anime_node, "my_start_date").text = "0000-00-00"
        ET.SubElement(anime_node, "my_finish_date").text = "0000-00-00"
        ET.SubElement(anime_node, "my_rated").text = ""
        ET.SubElement(anime_node, "my_score").text = str(anime["score"])
        ET.SubElement(anime_node, "my_dvd").text = ""
        ET.SubElement(anime_node, "my_storage").text = ""
        ET.SubElement(anime_node, "my_status").text = anime["status"]
        ET.SubElement(anime_node, "my_comments").text = ""
        ET.SubElement(anime_node, "my_times_watched").text = "0"
        ET.SubElement(anime_node, "my_rewatch_value").text = ""
        ET.SubElement(anime_node, "my_tags").text = ""
        ET.SubElement(anime_node, "my_rewatching").text = "0"
        ET.SubElement(anime_node, "my_rewatching_ep").text = "0"
        ET.SubElement(anime_node, "update_on_import").text = "1"

    # Generazione stringa con indentazione (Pretty Print)
    xml_str = minidom.parseString(ET.tostring(root, encoding='utf-8')).toprettyxml(indent="    ")
    
    with open(output_file, "w", encoding="utf-8") as f:
        # Pulisce le righe vuote generate in eccesso da minidom
        f.write('\n'.join([line for line in xml_str.split('\n') if line.strip()]))

def main() -> None:
    parser = argparse.ArgumentParser(description="Esporta la lista AnimeUnity in XML.")
    parser.add_argument("input_html", help="Il file HTML scaricato da AnimeUnity")
    parser.add_argument("-o", "--output", default="import_mal.xml", help="File XML di output")
    parser.add_argument("-j", "--json", default="orphans.json", help="File JSON per i non trovati")
    args = parser.parse_args()

    raw_anime_list = parse_animeunity_html(args.input_html)
    if not raw_anime_list:
        logger.error("Nessun anime trovato. Parsing fallito o HTML vuoto.")
        return
        
    logger.info(f"Trovati {len(raw_anime_list)} anime. Inizio validazione API...")

    success_list: List[Dict[str, Any]] = []
    orphans: List[Dict[str, Any]] = []

    for anime in raw_anime_list:
        clean_title = clean_title_for_api(anime['title'])
        mal_id = get_mal_id(clean_title)
        
        if mal_id:
            logger.info(f"[+] Trovato: {clean_title} (MAL ID: {mal_id})")
            anime['mal_id'] = mal_id
            success_list.append(anime)
        else:
            logger.warning(f"[-] Disperso: {anime['title']}")
            orphans.append({
                "original_title": anime['title'],
                "cleaned_title": clean_title,
                "status": anime['status'],
                "watched": anime['watched'],
                "score": anime['score']
            })
        
        time.sleep(0.8) # Cortesia verso le API

    if success_list:
        generate_robust_xml(success_list, args.output)
        logger.info(f"Completato. XML generato per {len(success_list)} anime in '{args.output}'.")

    if orphans:
        with open(args.json, 'w', encoding='utf-8') as f:
            json.dump(orphans, f, indent=4, ensure_ascii=False)
        logger.info(f"Salvati {len(orphans)} orfani in '{args.json}'.")

if __name__ == "__main__":
    main()
